rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.size() <= 254 &&
        request.auth.token.email == 'teto.oscar94@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Schema Blueprints (Synchronized verbatim with firebase-blueprint.json)
    // -------------------------------------------------------------------------
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.email == request.auth.token.email &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVaultManifest(data) {
      return data.keys().hasAll([
          'ownerUid',
          'appName',
          'chunkCount',
          'totalChannels',
          'totalSources',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'appName',
          'chunkCount',
          'totalChannels',
          'totalSources',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.appName is string &&
        data.appName.size() >= 2 &&
        data.appName.size() <= 64 &&
        data.chunkCount is int &&
        data.chunkCount >= 0 &&
        data.chunkCount <= 500 &&
        data.totalChannels is int &&
        data.totalChannels >= 0 &&
        data.totalChannels <= 500000 &&
        data.totalSources is int &&
        data.totalSources >= 0 &&
        data.totalSources <= 1000 &&
        data.status is string &&
        data.status.size() >= 6 &&
        data.status.size() <= 16 &&
        (data.status == 'active' || data.status == 'archived') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVaultChunk(data) {
      return data.keys().hasAll([
          'manifestId',
          'ownerUid',
          'chunkIndex',
          'cipherPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'manifestId',
          'ownerUid',
          'chunkIndex',
          'cipherPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.manifestId is string &&
        data.manifestId.size() >= 1 &&
        data.manifestId.size() <= 128 &&
        data.manifestId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.chunkIndex is int &&
        data.chunkIndex >= 0 &&
        data.chunkIndex <= 500 &&
        data.cipherPayload is string &&
        data.cipherPayload.size() >= 16 &&
        data.cipherPayload.size() <= 750000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection: /admins/{adminUid} (PII Isolated, No Enumeration)
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) && isAdmin());
      allow list: if false;

      allow create: if isBootstrappedAdmin() &&
        isValidId(adminUid) &&
        isOwner(adminUid) &&
        isValidAdminProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminProfile(incoming()) &&
        isOwner(adminUid) &&
        isAdmin() &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection: /vault_manifests/{manifestId}
    // -------------------------------------------------------------------------
    match /vault_manifests/{manifestId} {
      allow get: if isSignedIn() &&
        isValidId(manifestId) &&
        existing().ownerUid == request.auth.uid &&
        isAdmin();

      // Pillar 8: No get()/exists() in list; strict resource.data ownership check
      allow list: if isBootstrappedAdmin() &&
        existing().ownerUid == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(manifestId) &&
        isValidVaultManifest(incoming()) &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(manifestId) &&
        isValidVaultManifest(incoming()) &&
        existing().ownerUid == request.auth.uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() && (
          // Action 1: Sync active backup metadata (blocked if archived unless reactivated by admin)
          (existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'appName',
              'chunkCount',
              'totalChannels',
              'totalSources',
              'status',
              'updatedAt'
            ])) ||
          // Action 2: Admin escape hatch to recover/unarchive terminal state
          (isBootstrappedAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'appName',
              'chunkCount',
              'totalChannels',
              'totalSources',
              'status',
              'updatedAt'
            ]))
        );

      allow delete: if isVerifiedUser() &&
        isValidId(manifestId) &&
        existing().ownerUid == request.auth.uid &&
        isAdmin();

      // -----------------------------------------------------------------------
      // Subcollection: /vault_manifests/{manifestId}/chunks/{chunkId}
      // Pillar 1 Master Gate: Parent manifest must exist & belong to request.auth.uid
      // -----------------------------------------------------------------------
      match /chunks/{chunkId} {
        allow get: if isSignedIn() &&
          isValidId(manifestId) &&
          isValidId(chunkId) &&
          existing().ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/vault_manifests/$(manifestId)).data.ownerUid == request.auth.uid &&
          isAdmin();

        // Pillar 8: Zero get()/exists() in list; enforce resource.data ownership
        allow list: if isBootstrappedAdmin() &&
          existing().ownerUid == request.auth.uid &&
          existing().manifestId == manifestId;

        allow create: if isVerifiedUser() &&
          isValidId(manifestId) &&
          isValidId(chunkId) &&
          isValidVaultChunk(incoming()) &&
          incoming().manifestId == manifestId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/vault_manifests/$(manifestId)) &&
          get(/databases/$(database)/documents/vault_manifests/$(manifestId)).data.ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/vault_manifests/$(manifestId)).data.status == 'active' &&
          isAdmin();

        allow update: if isVerifiedUser() &&
          isValidId(manifestId) &&
          isValidId(chunkId) &&
          isValidVaultChunk(incoming()) &&
          existing().ownerUid == request.auth.uid &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().manifestId == existing().manifestId &&
          incoming().manifestId == manifestId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/vault_manifests/$(manifestId)).data.ownerUid == request.auth.uid &&
          isAdmin() && (
            // Action: Refresh encrypted chunk payload
            incoming().diff(existing()).affectedKeys().hasOnly([
              'chunkIndex',
              'cipherPayload',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedUser() &&
          isValidId(manifestId) &&
          isValidId(chunkId) &&
          existing().ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/vault_manifests/$(manifestId)).data.ownerUid == request.auth.uid &&
          isAdmin();
      }
    }
  }
}
